# Backend
MANFRIDAY_ENV=local
MANFRIDAY_HOST=0.0.0.0
MANFRIDAY_PORT=8000
MANFRIDAY_LOCAL_SECRET=change-me-local-secret

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL_SECONDS=3600

# Model provider
MODEL_PROVIDER=bedrock
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MAX_TOKENS=1024
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Speech providers
STT_PROVIDER=openai
STT_MODEL=gpt-4o-mini-transcribe
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# GoPro and frame sampler
GOPRO_SERIAL_SUFFIX=2312
GOPRO_OPEN_GOPRO_VERSION=0.22.0
GOPRO_COHN_CREDENTIALS_PATH=.state/gopro/cohn.json
FRAME_SAMPLE_FPS=2
FRAME_JPEG_QUALITY=80
FRAME_STALE_AFTER_SECONDS=5
FRAME_LOOK_TTL_SECONDS=60

# Retrieval
RETRIEVAL_LOCAL_DOCS_DIR=../knowledge/local-docs
RETRIEVAL_ONLINE_SOURCES_PATH=../knowledge/online-sources/sources.yaml
RETRIEVAL_INDEX_DIR=.state/retrieval
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=

# Sessions and debug
SESSION_IDLE_TIMEOUT_SECONDS=7200
WEBSOCKET_QUEUE_LIMIT=32
PUSH_TO_TALK_MAX_DURATION_SECONDS=20
DEBUG_ENABLED=false
DEBUG_ARTIFACTS_DIR=debug_artifacts
DEBUG_MAX_SESSIONS=10
